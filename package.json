{
  "name": "beatmatcher",
  "version": "5.7.2",
  "description": "A desktop app for practicing beat matching",
  "author": "berrutti",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dist": "tauri build",
    "format": "prettier . --write && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier . --check && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "icon": "tauri icon build/icon.png",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "test:watch": "vitest",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-store": "^2.4.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.5"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn lint && yarn lint:rust && yarn format"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.1"
  }
}
