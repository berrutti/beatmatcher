{
  "name": "beatmatcher",
  "version": "8.3.0",
  "description": "DJ software for live mixing and session editing, played on a keyboard or MIDI controller",
  "author": "berrutti",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build session-core --target web --out-dir pkg && node scripts/check-wasm-fresh.mjs --write",
    "check:commands": "node scripts/generate-command-types.mjs --check",
    "check:wasm": "node scripts/check-wasm-fresh.mjs",
    "circular-deps": "madge --circular --extensions ts,vue --ts-config tsconfig.web.json src/renderer/src",
    "compare-session": "cargo run --manifest-path src-tauri/Cargo.toml --release --bin compare_session --",
    "dead-code": "knip",
    "dev": "tauri dev",
    "dist": "tauri build",
    "clean": "cargo clean --manifest-path src-tauri/Cargo.toml && cargo clean --manifest-path session-core/Cargo.toml",
    "duplication": "jscpd src/renderer/src",
    "format": "prettier . --write --list-different && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier . --check && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "generate:commands": "node scripts/generate-command-types.mjs && prettier --write --log-level silent src/renderer/src/tauriCommands.ts",
    "icon": "tauri icon build/icon.png",
    "lint": "eslint . && node scripts/no-section-comments.mjs && node scripts/no-deep-selectors.mjs",
    "lint:ci": "eslint . --max-warnings=0 && node scripts/no-section-comments.mjs && node scripts/no-deep-selectors.mjs",
    "lint:fix": "eslint . --fix",
    "lint:rust": "cargo clippy --manifest-path session-core/Cargo.toml -- -D warnings && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "ocd": "node scripts/ocd.mjs",
    "predev": "yarn generate:commands && yarn build:wasm",
    "predist": "yarn generate:commands && yarn build:wasm",
    "test": "node scripts/check-wasm-fresh.mjs && vitest run",
    "test:rust": "cargo test --manifest-path session-core/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@fontsource/jost": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn lint && yarn lint:rust && yarn format"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
